#!/usr/bin/env bash
# Talk to the health API from the host, inside the docker network (bypasses the
# edge, so no sign-in; only someone with a shell on this box can reach it).
#   health GET /api/overview
#   health POST /api/log '{"food_id":3,"servings":1.5,"meal":"lunch"}'
#   health PUT /api/labs @results.json
#   health upload <document-id> <file>
set -euo pipefail
container=${HEALTH_CONTAINER:-health}
ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$container")
base="http://$ip:${HEALTH_PORT:-8790}"
case "${1:-}" in
  upload)
    f=$3
    curl -fsS -X PUT --data-binary @"$f" \
      -H "Content-Type: $(file -b --mime-type "$f")" \
      -H "X-Filename: $(printf %s "$(basename "$f")" | jq -sRr @uri)" \
      "$base/api/documents/$2/file"; echo ;;
  GET|POST|PUT|PATCH|DELETE)
    m=$1 p=$2; shift 2
    curl -sS -X "$m" -H 'Content-Type: application/json' ${1:+--data-binary "$1"} "$base$p"; echo ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
